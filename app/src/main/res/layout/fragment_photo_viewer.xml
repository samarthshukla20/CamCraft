<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/fullPhoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:contentDescription="Full-size photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/viewerToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Back -->
    <ImageButton
        android:id="@+id/btnViewerBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:tint="#FFFFFF"
        android:contentDescription="Close photo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Photo position -->
    <TextView
        android:id="@+id/txtPhotoPosition"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="1 / 1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="#99000000"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom toolbar -->
    <LinearLayout
        android:id="@+id/viewerToolbar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#171717"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Delete -->
        <ImageButton
            android:id="@+id/btnDeletePhoto"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_trash"
            android:tint="#FFFFFF"
            android:contentDescription="Delete photo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Edit -->
        <ImageButton
            android:id="@+id/btnEditPhoto"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            android:tint="#FFFFFF"
            android:contentDescription="Edit photo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Details -->
        <ImageButton
            android:id="@+id/btnPhotoDetails"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_info"
            android:tint="#FFFFFF"
            android:contentDescription="Photo details" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Share -->
        <ImageButton
            android:id="@+id/btnSharePhoto"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:tint="#FFFFFF"
            android:contentDescription="Share photo" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
