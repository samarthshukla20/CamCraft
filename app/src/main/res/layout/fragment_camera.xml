<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="performance"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cameraControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top toolbar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Settings: far left -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Open settings" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Grid -->
        <ImageButton
            android:id="@+id/btnGrid"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_grid"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Enable camera grid" />

        <!-- Flash -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_zap"
            android:tint="@null"
            android:scaleType="fitCenter"
            android:contentDescription="Change flash mode" />

        <!-- Timer -->
        <ImageButton
            android:id="@+id/btnTimer"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_timer_off"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Camera timer off" />

        <!-- Zoom -->
        <ImageButton
            android:id="@+id/btnZoom"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_zoom_in"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Show zoom controls" />

        <!-- Exposure -->
        <ImageButton
            android:id="@+id/btnExposure"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_exposure"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Show exposure controls" />

    </LinearLayout>

    <!-- Camera grid overlay -->
    <com.samarthshukla.camcraft.ui.camera.CameraGridView
        android:id="@+id/cameraGridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- Countdown -->
    <TextView
        android:id="@+id/txtCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3"
        android:textColor="#FFFFFF"
        android:textSize="88sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="#99000000"
        android:shadowRadius="12"
        android:shadowDx="2"
        android:shadowDy="2"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <TextView
        android:id="@+id/txtBurstCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"
        android:background="#CC151515"
        android:text="BURST  •  0"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cancel countdown -->
    <TextView
        android:id="@+id/btnCancelCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CANCEL"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtCountdown"
        app:layout_constraintStart_toStartOf="@id/txtCountdown"
        app:layout_constraintEnd_toEndOf="@id/txtCountdown" />

    <!-- Focus indicator -->
    <View
        android:id="@+id/focusIndicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_focus_indicator"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <!-- Zoom slider panel -->
    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#DD151515"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_zoom_in"
                android:tint="#FFFFFF"
                android:contentDescription="Zoom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ZOOM"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/txtZoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekZoom"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

    </LinearLayout>

    <!-- Exposure slider panel -->
    <LinearLayout
        android:id="@+id/exposureControls"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="#DD151515"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_exposure"
                android:tint="#FFFFFF"
                android:contentDescription="Exposure" />

            <TextView
                android:id="@+id/txtExposure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="EV 0"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnResetExposure"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_rotate_ccw"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"
                android:contentDescription="Reset exposure" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/seekExposure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="24"
            android:progress="12" />

    </LinearLayout>

    <!-- Bottom camera toolbar -->
    <LinearLayout
        android:id="@+id/cameraControls"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="28dp"
        android:background="#00000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Gallery: far left -->
        <FrameLayout
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="Open gallery">

            <ImageView
                android:id="@+id/imgLastPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#333333"
                android:contentDescription="Last captured photo" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:padding="2dp"
                android:background="#99000000"
                android:src="@drawable/ic_gallery"
                android:tint="#FFFFFF"
                android:contentDescription="Gallery" />

        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Capture: centre -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_shutter_button"
            android:src="@null"
            android:contentDescription="Take photo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Switch camera: far right -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_switch_camera"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Switch camera" />

    </LinearLayout>

    <!-- Capture flash overlay -->
    <View
        android:id="@+id/captureFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

</androidx.constraintlayout.widget.ConstraintLayout>
